MODE=primary
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/bank_primary?sslmode=disable
LISTEN_ADDR=:8080

REPLICATION_URL=http://127.0.0.1:8081/internal/replicate/event
REPLICATION_KEY=super-secret

POLL_INTERVAL_MS=250
BATCH_SIZE=32
HTTP_TIMEOUT_MS=1500
MAX_RETRY_SECONDS=30
MAX_CONCURRENT_CLIENTS=200